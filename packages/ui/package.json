{
  "name": "@seckit/ui",
  "version": "0.1.0",
  "description": "Security Kit in the browser: describe your app, read its security plan, run checks and record sign-offs — served locally, nothing leaves your machine.",
  "keywords": [
    "security",
    "owasp",
    "checklist",
    "ai-prompt"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "seckit-ui": "./dist/server/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    },
    "./bin": "./dist/server/bin.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-app.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@seckit/cli": "0.1.0",
    "@seckit/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5",
    "esbuild": "^0.28.0"
  }
}
